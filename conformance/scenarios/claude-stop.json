{
  "description": "Stopping a running Claude turn: the fake claude holds a turn whose text starts with \"wait\" until it gets an interrupt control request.",
  "tier": "p2",
  "steps": [
    {
      "op": "call",
      "as": "project",
      "method": "projects.mutate",
      "payload": {
        "type": "project.create",
        "commandId": "${uuid:cmd-project}",
        "projectId": "${uuid:project}",
        "title": "workspace",
        "workspaceRoot": "${workspace}"
      }
    },
    {
      "op": "subscribe",
      "as": "shell",
      "method": "orchestration.subscribeShell",
      "payload": {},
      "aside": [
        {
          "kind": "snapshot",
          "resolvedRepositoryIdentityRoots": "$present"
        }
      ]
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "create",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "thread.create",
        "createdBy": "user",
        "creationSource": "web",
        "commandId": "${uuid:cmd-create}",
        "threadId": "${uuid:thread}",
        "projectId": "${uuid:project}",
        "title": "First thread",
        "modelSelection": {
          "instanceId": "claudeAgent",
          "model": "claude-opus-5-5"
        },
        "runtimeMode": "full-access",
        "interactionMode": "default",
        "branch": null,
        "worktreePath": null
      }
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "thread.updated"
      }
    },
    {
      "op": "subscribe",
      "as": "thread",
      "method": "orchestration.subscribeThread",
      "payload": {
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "send",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "message.dispatch",
        "commandId": "${uuid:cmd-send}",
        "createdBy": "user",
        "creationSource": "web",
        "threadId": "${uuid:thread}",
        "messageId": "${uuid:cmd-send}",
        "text": "wait for stop",
        "attachments": [],
        "dispatchMode": {
          "type": "start_immediately"
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "provider-turn.updated",
          "payload": {
            "status": "running"
          }
        }
      }
    },
    {
      "op": "call",
      "as": "stop",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "thread.stop",
        "commandId": "${uuid:cmd-stop}",
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "turn-item.updated",
          "payload": {
            "type": "run_interrupt_request"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "turn-item.updated",
          "payload": {
            "type": "run_interrupt_result"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "turn-item.updated",
          "payload": {
            "type": "checkpoint"
          }
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.updated",
          "payload": {
            "status": "interrupted"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "thread.updated",
        "thread": {
          "status": "interrupted"
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "interrupt",
      "stream": "thread"
    },
    {
      "op": "subscribe",
      "as": "after",
      "method": "orchestration.subscribeThread",
      "payload": {
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "after",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "interrupt",
      "stream": "after"
    },
    {
      "op": "await",
      "stream": "shell",
      "fromAside": true,
      "match": {
        "kind": "snapshot"
      },
      "record": "match",
      "ignore": [
        "snapshotSequence",
        "threads"
      ]
    },
    {
      "op": "interrupt",
      "stream": "shell"
    }
  ]
}