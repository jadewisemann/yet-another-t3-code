{
  "description": "Turn diffs from checkpoints: after a codex turn that adds hello.txt, the patch between turn 0 and turn 1, the full thread diff, an empty range, and the errors for a turn that has not happened and for an unknown thread.",
  "tier": "p2",
  "steps": [
    {
      "op": "call",
      "as": "project",
      "method": "projects.mutate",
      "payload": {
        "type": "project.create",
        "commandId": "${uuid:cmd-project}",
        "projectId": "${uuid:project}",
        "title": "workspace",
        "workspaceRoot": "${workspace}"
      }
    },
    {
      "op": "subscribe",
      "as": "shell",
      "method": "orchestration.subscribeShell",
      "payload": {},
      "aside": [
        {
          "kind": "snapshot",
          "resolvedRepositoryIdentityRoots": "$present"
        }
      ]
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "create",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "thread.create",
        "createdBy": "user",
        "creationSource": "web",
        "commandId": "${uuid:cmd-create}",
        "threadId": "${uuid:thread}",
        "projectId": "${uuid:project}",
        "title": "First thread",
        "modelSelection": {
          "instanceId": "codex",
          "model": "gpt-5.5"
        },
        "runtimeMode": "full-access",
        "interactionMode": "default",
        "branch": null,
        "worktreePath": null
      }
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "thread.updated"
      }
    },
    {
      "op": "subscribe",
      "as": "thread",
      "method": "orchestration.subscribeThread",
      "payload": {
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "send",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "message.dispatch",
        "commandId": "${uuid:cmd-send}",
        "createdBy": "user",
        "creationSource": "web",
        "threadId": "${uuid:thread}",
        "messageId": "${uuid:cmd-send}",
        "text": "tools please",
        "attachments": [],
        "dispatchMode": {
          "type": "start_immediately"
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "checkpoint.captured",
          "payload": {
            "appRunOrdinal": 1
          }
        }
      },
      "timeoutMs": 10000
    },
    {
      "op": "interrupt",
      "stream": "thread"
    },
    {
      "op": "call",
      "as": "turn",
      "method": "orchestration.getTurnDiff",
      "payload": {
        "threadId": "${uuid:thread}",
        "fromTurnCount": 0,
        "toTurnCount": 1
      }
    },
    {
      "op": "call",
      "as": "full",
      "method": "orchestration.getFullThreadDiff",
      "payload": {
        "threadId": "${uuid:thread}",
        "toTurnCount": 1,
        "ignoreWhitespace": false
      }
    },
    {
      "op": "call",
      "as": "same",
      "method": "orchestration.getTurnDiff",
      "payload": {
        "threadId": "${uuid:thread}",
        "fromTurnCount": 1,
        "toTurnCount": 1
      }
    },
    {
      "op": "call",
      "as": "zero",
      "method": "orchestration.getFullThreadDiff",
      "payload": {
        "threadId": "${uuid:thread}",
        "toTurnCount": 0
      }
    },
    {
      "op": "call",
      "as": "beyond",
      "method": "orchestration.getTurnDiff",
      "payload": {
        "threadId": "${uuid:thread}",
        "fromTurnCount": 0,
        "toTurnCount": 2
      }
    },
    {
      "op": "call",
      "as": "unknown",
      "method": "orchestration.getTurnDiff",
      "payload": {
        "threadId": "${uuid:other}",
        "fromTurnCount": 0,
        "toTurnCount": 1
      }
    },
    {
      "op": "interrupt",
      "stream": "shell"
    }
  ]
}
