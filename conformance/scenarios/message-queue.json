{
  "description": "Queueing a message behind a running turn, as YATT does when the user sends while the agent works: the fake codex holds a turn whose text starts with \"slow\" for a second. The queued message gets a queued run with no turn item; when the active run completes, the queued run starts on the same provider thread with a queued_turn user item. A later message starts at once on the idle provider thread.",
  "tier": "p2",
  "steps": [
    {
      "op": "call",
      "as": "project",
      "method": "projects.mutate",
      "payload": {
        "type": "project.create",
        "commandId": "${uuid:cmd-project}",
        "projectId": "${uuid:project}",
        "title": "workspace",
        "workspaceRoot": "${workspace}"
      }
    },
    {
      "op": "subscribe",
      "as": "shell",
      "method": "orchestration.subscribeShell",
      "payload": {},
      "aside": [
        {
          "kind": "snapshot",
          "resolvedRepositoryIdentityRoots": "$present"
        }
      ]
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "create",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "thread.create",
        "createdBy": "user",
        "creationSource": "web",
        "commandId": "${uuid:cmd-create}",
        "threadId": "${uuid:thread}",
        "projectId": "${uuid:project}",
        "title": "First thread",
        "modelSelection": {
          "instanceId": "codex",
          "model": "gpt-5.5"
        },
        "runtimeMode": "full-access",
        "interactionMode": "default",
        "branch": null,
        "worktreePath": null
      }
    },
    {
      "op": "await",
      "stream": "shell",
      "match": {
        "kind": "thread.updated"
      }
    },
    {
      "op": "subscribe",
      "as": "thread",
      "method": "orchestration.subscribeThread",
      "payload": {
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "call",
      "as": "send",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "message.dispatch",
        "commandId": "${uuid:cmd-send}",
        "createdBy": "user",
        "creationSource": "web",
        "threadId": "${uuid:thread}",
        "messageId": "${uuid:cmd-send}",
        "text": "slow first message",
        "attachments": [],
        "dispatchMode": {
          "type": "start_immediately"
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "provider-turn.updated",
          "payload": {
            "status": "running"
          }
        }
      }
    },
    {
      "op": "call",
      "as": "queued",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "message.dispatch",
        "commandId": "${uuid:cmd-queued}",
        "createdBy": "user",
        "creationSource": "web",
        "threadId": "${uuid:thread}",
        "messageId": "${uuid:cmd-queued}",
        "text": "second message",
        "attachments": [],
        "dispatchMode": {
          "type": "queue_after_active"
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.created",
          "payload": {
            "status": "queued"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "message.updated",
          "payload": {
            "role": "user",
            "text": "second message"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.updated",
          "payload": {
            "ordinal": 1,
            "status": "completed"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ],
      "timeoutMs": 15000
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "turn-item.updated",
          "payload": {
            "type": "user_message",
            "inputIntent": "queued_turn"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.updated",
          "payload": {
            "ordinal": 2,
            "status": "starting"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.updated",
          "payload": {
            "ordinal": 2,
            "status": "completed"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ],
      "timeoutMs": 15000
    },
    {
      "op": "call",
      "as": "third",
      "method": "orchestration.dispatchCommand",
      "payload": {
        "type": "message.dispatch",
        "commandId": "${uuid:cmd-third}",
        "createdBy": "user",
        "creationSource": "web",
        "threadId": "${uuid:thread}",
        "messageId": "${uuid:cmd-third}",
        "text": "third message",
        "attachments": [],
        "dispatchMode": {
          "type": "start_immediately"
        }
      }
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "turn-item.updated",
          "payload": {
            "type": "user_message",
            "inputIntent": "turn_start",
            "text": "third message"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ]
    },
    {
      "op": "await",
      "stream": "thread",
      "match": {
        "kind": "event",
        "event": {
          "type": "run.updated",
          "payload": {
            "ordinal": 3,
            "status": "completed"
          }
        }
      },
      "record": "match",
      "ignore": [
        "sequence"
      ],
      "timeoutMs": 15000
    },
    {
      "op": "interrupt",
      "stream": "thread"
    },
    {
      "op": "subscribe",
      "as": "after",
      "method": "orchestration.subscribeThread",
      "payload": {
        "threadId": "${uuid:thread}"
      }
    },
    {
      "op": "await",
      "stream": "after",
      "match": {
        "kind": "snapshot"
      }
    },
    {
      "op": "interrupt",
      "stream": "after"
    },
    {
      "op": "await",
      "stream": "shell",
      "fromAside": true,
      "match": {
        "kind": "snapshot"
      },
      "record": "match",
      "ignore": [
        "snapshotSequence",
        "threads"
      ]
    },
    {
      "op": "interrupt",
      "stream": "shell"
    }
  ]
}
