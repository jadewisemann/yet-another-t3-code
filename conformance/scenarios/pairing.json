{
  "description": "A one-time pairing credential from `auth pairing create` is exchanged at /oauth/token for a bearer token, which then opens /ws. The same credential cannot be exchanged twice, and the credential itself is not a bearer token.",
  "tier": "p1",
  "steps": [
    {
      "op": "cli",
      "args": [
        "auth",
        "pairing",
        "create",
        "--json",
        "--label",
        "conformance"
      ],
      "capture": {
        "pairing": "credential"
      }
    },
    {
      "op": "http",
      "httpMethod": "POST",
      "path": "/oauth/token",
      "contentType": "application/x-www-form-urlencoded",
      "body": "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Atoken-exchange&subject_token=${var:pairing}&subject_token_type=urn%3At3%3Aparams%3Aoauth%3Atoken-type%3Aenvironment-bootstrap&requested_token_type=urn%3Aietf%3Aparams%3Aoauth%3Atoken-type%3Aaccess_token",
      "capture": {
        "access": "access_token"
      }
    },
    {
      "op": "connect",
      "bearer": "${var:access}"
    },
    {
      "op": "http",
      "httpMethod": "POST",
      "path": "/oauth/token",
      "contentType": "application/x-www-form-urlencoded",
      "body": "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Atoken-exchange&subject_token=${var:pairing}&subject_token_type=urn%3At3%3Aparams%3Aoauth%3Atoken-type%3Aenvironment-bootstrap&requested_token_type=urn%3Aietf%3Aparams%3Aoauth%3Atoken-type%3Aaccess_token"
    },
    {
      "op": "connect",
      "bearer": "${var:pairing}"
    }
  ]
}
